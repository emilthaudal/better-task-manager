# ── Atlassian OAuth 2.0 (3LO) ────────────────────────────────────────────────
# Register an app at https://developer.atlassian.com/console/myapps/
# Set the callback URL to: https://<your-host>/api/auth/callback
# Add scopes: read:jira-work  write:jira-work  read:jira-user  offline_access
ATLASSIAN_CLIENT_ID=your_client_id_here
ATLASSIAN_CLIENT_SECRET=your_client_secret_here

# ── Session ───────────────────────────────────────────────────────────────────
# Random string of at least 32 characters used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-char-string-at-least

# ── App URL ───────────────────────────────────────────────────────────────────
# The public URL of this app — used to construct the OAuth callback URL.
# Leave as http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Local dev bypass (optional) ───────────────────────────────────────────────
# Set JIRA_BYPASS=true to skip OAuth and use Basic auth (Personal API token).
# Only for local development — never use in production.
# JIRA_BYPASS=true
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_api_token_here
# NEXT_PUBLIC_JIRA_BASE_URL=https://your-org.atlassian.net

